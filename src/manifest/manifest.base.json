{
  "manifest_version": 3,
  "name": "Auto Refresh",
  "version": "1.0.0",
  "description": "Automatically reload selected tabs at configurable intervals with duration, count, and deadline limits. Local-first and privacy-preserving.",
  "permissions": ["alarms", "notifications", "sessions", "storage", "tabs"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Auto Refresh",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
